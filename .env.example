# Enables arms C and D (model-backed diagnosis). Without it they run from the
# committed response cache and fall back to the deterministic path on a miss,
# counted openly as degraded decisions.
ANTHROPIC_API_KEY=

# Test keys only. The REST client refuses to start on an rzp_live_ key unless
# VASOOL_ALLOW_LIVE_KEYS=1 is also set.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# How to launch Razorpay's official MCP server for the --mcp backend.
# VASOOL_MCP_CMD=docker run --rm -i -e RAZORPAY_KEY_ID -e RAZORPAY_KEY_SECRET razorpay/mcp

# VASOOL_MODEL=claude-opus-5
# VASOOL_EFFORT=low
