# ---------------------------------------------------------------------------
# The reasoning zone. Pick ONE. All of the free options below work without a
# credit card; the architecture does not care which one you use, which is
# rather the point.
# ---------------------------------------------------------------------------

# (a) Local, no account, no cost. `brew install ollama && ollama serve`
# VASOOL_PROVIDER=ollama
# VASOOL_MODEL=qwen2.5:7b

# (b) Any OpenAI-shaped endpoint — Groq, Google AI Studio, OpenRouter, Cerebras.
#     All have a free tier that does not ask for a card.
# VASOOL_PROVIDER=openai_compat
# VASOOL_BASE_URL=https://api.groq.com/openai/v1
# VASOOL_MODEL=llama-3.3-70b-versatile
# VASOOL_API_KEY=

# (c) Anthropic. Used automatically when this is set and VASOOL_PROVIDER is not.
#     This is the only option with a cost attached.
ANTHROPIC_API_KEY=

# Test keys only. The REST client refuses to start on an rzp_live_ key unless
# VASOOL_ALLOW_LIVE_KEYS=1 is also set.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# How to launch Razorpay's official MCP server for the --mcp backend.
# VASOOL_MCP_CMD=docker run --rm -i -e RAZORPAY_KEY_ID -e RAZORPAY_KEY_SECRET razorpay/mcp

# VASOOL_MODEL=claude-opus-5
# VASOOL_EFFORT=low
